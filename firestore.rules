rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // Cualquier cuenta con correo: Google (verificada) o correo+contraseña (alta propia)
    function authed() {
      return request.auth != null && request.auth.token.email is string
        && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password');
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }
    function isApproved() {
      return authed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    function validName(v) {
      return v is string && v.size() >= 2 && v.size() <= 60;
    }

    // Profesores: se dan de alta a mano en la consola. Cada uno solo puede completar su nombre.
    match /admins/{email} {
      allow read: if signedIn() && myEmail() == email;
      allow update: if signedIn() && myEmail() == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'surname'])
        && validName(request.resource.data.name)
        && validName(request.resource.data.surname);
      allow create, delete: if false;
    }

    match /users/{uid} {
      allow get: if (authed() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();

      // Alta propia (alumno con Google o con correo y contraseña): siempre pendiente
      allow create: if authed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'surname', 'status', 'role', 'consent', 'createdAt'])
        && request.resource.data.email == myEmail()
        && validName(request.resource.data.name)
        && validName(request.resource.data.surname)
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'student'
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;

      // Alta manual por el profesor (uid generado, empieza por "m_")
      allow create: if isAdmin()
        && uid.matches('m_[0-9a-z]+')
        && request.resource.data.keys().hasOnly(['email', 'name', 'surname', 'status', 'role', 'consent', 'belt', 'stripes', 'beltSince', 'history', 'source', 'createdAt', 'createdBy'])
        && validName(request.resource.data.name)
        && validName(request.resource.data.surname)
        && request.resource.data.status == 'approved'
        && request.resource.data.role == 'student'
        && request.resource.data.source == 'manual'
        && request.resource.data.belt in ['blanco', 'azul', 'morado', 'marron', 'negro']
        && request.resource.data.stripes is int
        && request.resource.data.stripes >= 0
        && request.resource.data.stripes <= 4;

      // El alumno solo puede corregir su nombre y apellidos
      allow update: if (authed() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'surname'])
          && validName(request.resource.data.name)
          && validName(request.resource.data.surname))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'belt', 'stripes', 'beltSince', 'history', 'name', 'surname', 'reviewedAt', 'reviewedBy'])
          && request.resource.data.status in ['pending', 'approved', 'rejected', 'inactive']
          && validName(request.resource.data.name)
          && validName(request.resource.data.surname)
          && (!('belt' in request.resource.data) || request.resource.data.belt in ['blanco', 'azul', 'morado', 'marron', 'negro'])
          && (!('stripes' in request.resource.data) || (request.resource.data.stripes is int && request.resource.data.stripes >= 0 && request.resource.data.stripes <= 4)));

      // Solo se pueden borrar fichas manuales (al unirlas con la cuenta real del alumno)
      allow delete: if isAdmin() && uid.matches('m_[0-9a-z]+');

      // Copia de la asistencia de cada alumno (solo la ve él y los profesores)
      match /att/{date} {
        allow read: if (authed() && request.auth.uid == uid) || isAdmin();
        allow write: if isAdmin()
          && (request.resource == null || request.resource.data.v in ['p', 'a', 'j']);
      }
    }

    // Configuración de la academia (horario, requisitos)
    match /config/{docId} {
      allow read: if authed();
      allow write: if isAdmin();
    }

    // Calendario: festivos y clases extra por fecha (YYYY-MM-DD)
    match /sessions/{date} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin();
    }

    // Lista completa de cada clase: solo profesores
    match /attendance/{date} {
      allow read, write: if isAdmin();
    }

    function validLink(v) {
      return v is string && (v == '' || (v.size() <= 500 && v.matches('https?://.+')));
    }

    // Comunidad: eventos, competiciones y avisos. Publican los profesores, leen los alumnos aprobados
    match /posts/{id} {
      allow read: if isAdmin() || isApproved();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['type', 'title', 'text', 'date', 'link', 'pinned', 'by', 'byName', 'createdAt', 'updatedAt'])
        && request.resource.data.type in ['evento', 'competicion', 'aviso']
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() <= 3000
        && request.resource.data.date is string && (request.resource.data.date == '' || request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && validLink(request.resource.data.link);
      allow delete: if isAdmin();
    }

    // Técnicas con vídeo: por ahora solo profesores
    match /techniques/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'category', 'belt', 'desc', 'video', 'by', 'createdAt', 'updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 120
        && request.resource.data.category is string && request.resource.data.category.size() <= 40
        && request.resource.data.belt in ['', 'blanco', 'azul', 'morado', 'marron', 'negro']
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 3000
        && validLink(request.resource.data.video);
    }
  }
}
